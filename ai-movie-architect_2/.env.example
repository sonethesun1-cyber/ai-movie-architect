# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get an API key from https://console.anthropic.com (Settings -> API Keys).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model used for generation. Defaults to claude-sonnet-5.
# Use claude-opus-5 for the highest-quality (slower/pricier) generations.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: only needed if you want the real "ສ້າງຮູບ (Generate Image)" button
# (Character/Storyboard/Location/Poster cards) to work. Separate key, separate
# billing from Anthropic -- get one from https://aistudio.google.com and
# enable billing there (no free tier for image generation). Leave blank to
# skip this feature entirely; everything else in the app works without it.
GOOGLE_API_KEY=

# Optional: which Gemini image model the "ສ້າງຮູບ" button calls.
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# Optional: change the local port the server runs on.
PORT=3000

# Optional: protect the app with a shared password before you deploy it
# somewhere public. Leave this blank/unset for local use (no login screen).
# If set, visitors must enter this password once (it's remembered for 2
# weeks) before they can use the app or call the API — this is what stops a
# stranger who finds your public URL from spending your Anthropic credits.
SITE_PASSWORD=

# Optional: cap how many times a single visitor can click "Generate" per
# hour, as a second layer of protection beyond SITE_PASSWORD. Default: 20.
GENERATE_RATE_LIMIT_PER_HOUR=20
